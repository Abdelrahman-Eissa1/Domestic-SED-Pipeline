CLASS_NAMES = ["keyboard_typing", "cutlery_dishes", "phone_ringing", "running_water", "microwave", 
               "vacuum_cleaner", "toilet_flushing", "footsteps", "keychain", "coffee_machine", 
               "bell_ringing", "wardrobe_drawer_open_close", "door_open_close", "light_switch", "window_open_close"]

# Difference in F1 scores (Smoothed - Raw) from your report graph
deltas = [0.027, 0.022, 0.011, 0.009, 0.005, 0.002, 0.001, -0.0005, -0.001, -0.003, -0.015, -0.024, -0.028, -0.035, -0.038]

